default_platform(:ios)

BUNDLE_ID    = "com.mindful.sports"
APP_NAME     = "Mindful Sports"
IOS_SCHEME   = "iosApp"

# ── iOS Lanes ─────────────────────────────────────────────────────────────────

platform :ios do

  # Build and upload to TestFlight.
  # Usage (CI): fastlane ios build supabase_url:"..." supabase_key:"..." revenuecat_key:"..."
  lane :build do |options|
    match(
      type:           "appstore",
      app_identifier: BUNDLE_ID,
      readonly:       true,
    )

    gym(
      scheme:           IOS_SCHEME,
      configuration:    "Release",
      export_method:    "app-store",
      output_directory: "build/ios",
      output_name:      "#{IOS_SCHEME}.ipa",
      xcargs: [
        "SUPABASE_URL=#{options[:supabase_url] || ''}",
        "SUPABASE_ANON_KEY=#{options[:supabase_key] || ''}",
        "REVENUECAT_KEY=#{options[:revenuecat_key] || ''}",
      ].join(" "),
    )

    pilot(
      app_identifier:                    BUNDLE_ID,
      ipa:                               "build/ios/#{IOS_SCHEME}.ipa",
      skip_waiting_for_build_processing: true,
      changelog:                         "Automated build — #{APP_NAME}",
    )
  end

  # One-time setup: generate/sync code-signing certs for the bundle ID.
  # Run locally on a machine with Apple Developer access.
  # Usage: fastlane ios setup_signing
  lane :setup_signing do
    match(
      type:           "appstore",
      app_identifier: BUNDLE_ID,
      readonly:       false,
    )
  end

  # One-time: create the App Store Connect listing.
  # Usage: fastlane ios create_listing
  lane :create_listing do
    produce(
      app_identifier: BUNDLE_ID,
      app_name:       APP_NAME,
      language:       "English",
      app_version:    "2.0",
      sku:            "mindful_sports",
    )
  end

end

# ── Android Lanes ─────────────────────────────────────────────────────────────

platform :android do

  # Build release AAB and upload to Play Store internal track.
  # Usage (CI): fastlane android build keystore_path:"/path/ks.jks" ...
  lane :build do |options|
    gradle(
      task:        "bundle",
      build_type:  "Release",
      project_dir: "./",
      flags:       "--no-daemon",
      properties: {
        "android.injected.signing.store.file"     => options[:keystore_path],
        "android.injected.signing.store.password" => options[:keystore_password],
        "android.injected.signing.key.alias"      => options[:key_alias],
        "android.injected.signing.key.password"   => options[:key_password],
      },
    )

    supply(
      package_name:   BUNDLE_ID,
      aab:            "composeApp/build/outputs/bundle/release/*.aab",
      track:          "internal",
      release_status: "draft",
    )
  end

end
